{
  "name": "sap-bah-sandbox",
  "version": "1.0.0",
  "private": true,
  "description": "Local sandbox for SAP Business Accelerator Hub: catalog change tracking, spec-driven mock server, test runner and traffic inspector",
  "license": "MIT",
  "author": "Bais <bais@bais.info> (https://bais.info)",
  "homepage": "https://github.com/bdbais/sap-bah-sandbox#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bdbais/sap-bah-sandbox.git"
  },
  "bugs": {
    "url": "https://github.com/bdbais/sap-bah-sandbox/issues"
  },
  "funding": {
    "type": "paypal",
    "url": "https://paypal.me/bellizia"
  },
  "keywords": [
    "sap",
    "sap-integration-suite",
    "cpi",
    "odata",
    "openapi",
    "mock-server",
    "api-testing"
  ],
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/postbuild.js",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "sync": "node dist/cli/sync.js",
    "sync:dev": "tsx src/cli/sync.ts",
    "test:apis": "node dist/cli/test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@faker-js/faker": "^9.3.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.1",
    "js-yaml": "^4.1.0",
    "multer": "^2.0.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
